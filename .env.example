# Local development only. Replace this value before starting PostgreSQL.
NOORPATH_DB_PASSWORD=change-me-local-only
# API connection string; keep real credentials out of committed configuration.
ConnectionStrings__NoorPath=Host=localhost;Port=5432;Database=noorpath;Username=noorpath;Password=change-me-local-only
# Hosting only: set true when the API should apply registered migrations before accepting traffic.
Database__MigrateOnStartup=false
# Web server-only base URL used by Next.js rewrites (for example, https://api.example.com).
NOORPATH_API_URL=http://localhost:5000
Authentication__Mode=Test
# Production uses Bearer plus Authentication__Authority and Authentication__Audience.
# Test mode is rejected outside Development/Test environments.
# Auth0 Regular Web Application settings. Keep real values in the hosting provider.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex key used only to encrypt web session cookies.
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# Auth0 API identifier configured for the NoorPath bearer API.
AUTH0_AUDIENCE=https://api.noorpath.in

# Platform publication approvers are independent from operator membership.
# Production identity policy must require MFA for each configured account.
Authorization__PlatformPublicationApproverAccountIds__0=platform-publisher
# Platform shell access is explicit and separate from operator membership.
Authorization__PlatformAdministratorAccountIds__0=platform-administrator
Documents__ProductionEnabled=false
# Production enablement additionally requires legal/privacy and deployed security approval.
Documents__Bucket=
Documents__ClamAvHost=localhost
Documents__ClamAvPort=3310

# VS-16 remains fail-closed until a Product Owner-approved policy is configured.
CancellationPolicy__Enabled=false
CancellationPolicy__Version=
CancellationPolicy__TimeZoneId=
CancellationPolicy__DepartureLocalTime=
CancellationPolicy__RefundProcessingBusinessDays=0
# Add approved windows only in managed environment configuration, for example:
# CancellationPolicy__Windows__0__MinimumDaysBeforeDeparture=
# CancellationPolicy__Windows__0__FeeBasisPoints=
# CancellationPolicy__Windows__0__NonRefundableAmount=
# Production refund execution remains disabled until provider/legal approval.
RefundExecution__Enabled=false
