  "deferredCapabilities": [
    "Production refund-provider execution",
    "Production document storage until S3 and malware-scanning controls are approved",
    "Supplier, airline, hotel and insurance integrations",
    "Automated WhatsApp notifications",
    "Multi-region operation and speculative scaling infrastructure"
  ],
  "thresholds": {
    "p95ApiLatencyMs": 1500,
    "maximumErrorRatePercent": 1,
    "maximumConcurrentCheckouts": 10
  },
  "recovery": {
    "rpoMinutes": 60,
    "rtoMinutes": 120,
    "backupRetentionDays": 7,
    "restoreOwner": "Release Operator"
  },
  "monitoring": {
    "alertOwner": "Release Operator",
    "escalationTarget": "Product Owner",
    "requiredSignals": [
      "api_readiness_failure",
      "payment_failure",
      "confirmation_exception",
      "inventory_commitment_failure",
      "document_processing_failure",
      "visa_transition_failure",
      "cancellation_failure",
      "refund_reconciliation_failure",
      "migration_failure"
    ]
  },
  "features": {
    "refundExecution": {
      "enabled": false,
      "approved": false
    },
    "documentStorage": {
      "enabled": false,
      "approved": false
    },
    "externalNotifications": {
      "enabled": false,
      "approved": false
    }
  },
  "releaseControls": {
    "releaseOperator": "Engineering Release Operator",
    "rollbackAuthority": "Product Owner",
    "changeWindow": "Product Owner-approved low-traffic window",
    "observationMinutes": 30,
    "productionDeploymentRequiresSeparateApproval": true
  },
  "postDeploymentSmokeTests": [
    "GET /health/live returns 200",
    "GET /health/ready returns 200",
    "Public discovery loads without a server error",
    "Customer sign-in entry is available",
    "Operator sign-in entry is available"
  ]
